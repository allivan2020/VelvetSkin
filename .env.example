# MongoDB
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/velvet-skin

# Admin CRM password (required for /admin)
ADMIN_PASSWORD=change-me-strong-password
# Do NOT wrap in quotes on Vercel. Value must match what you type on /admin/login.
# Optional separate signing secret; falls back to ADMIN_PASSWORD
# ADMIN_SESSION_SECRET=long-random-string

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cloudflare Turnstile (booking captcha)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAACppbzwvZa1GFBX5

# Groq AI (quiz summary + admin agent). Optional.
GROQ_API_KEY=
# Override model if Groq deprecates the default (openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b

# Private phone calendar subscription (ICS). Use a long random secret (≥16 chars).
# Admin → Календар: one-tap «Додати в Календар iPhone». Do not share the feed URL.
CALENDAR_FEED_TOKEN=

# Morning master Telegram digest (Vercel Cron → /api/cron/reminders at 06:00 UTC = 08:00 Europe/Kyiv).
# Vercel sends Authorization: Bearer <CRON_SECRET>. Manual: curl -H "Authorization: Bearer $CRON_SECRET" ...
# Do NOT put the secret in the URL query string.
# Also used by hourly /api/cron/busy-sync (personal iPhone ICS → CRM notes).
CRON_SECRET=
